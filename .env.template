# =============================================================
# 玺鸿珠宝 - 部署环境配置模板
# 复制为 .env 并填写实际值后再部署
# =============================================================

# ------- 域名 -------
API_DOMAIN=api.xihongzhubao.com
BACKSTAGE_DOMAIN=xihongzhubao.com

# ------- 后端（PostgreSQL + Redis） -------
POSTGRES_DB=xihong
DATABASE_USER=xihong
DATABASE_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-another-long-random-password
PUBLIC_BASE_URL=https://api.xihongzhubao.com
CORS_ALLOWED_ORIGINS=https://xihongzhubao.com,https://www.xihongzhubao.com
# compose 会强制 APP_PRODUCTION=true，并拒绝开启任何模拟用户/支付模式

# ------- 管理员初始账号（首次启动自动创建） -------
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-admin-password

# JWT 签名密钥（至少 32 个随机字符，且两把密钥不得复用）
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters-for-admin-jwt

# ------- 微信小程序 -------
WECHAT_ORIGINAL_ID=
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_MESSAGE_TOKEN=
# 微信后台生成的 43 位 EncodingAESKey
WECHAT_MESSAGE_AES_KEY=
WECHAT_MESSAGE_CALLBACK_URL=https://api.xihongzhubao.com/api/wechat/miniprogram/message-push

# ------- 微信支付 -------
WX_PAY_APPID=
WX_PAY_MCH_ID=
# 微信支付 APIv3 密钥必须为 32 字节
WX_PAY_API_V3_KEY=
WX_PAY_SERIAL_NO=
# 宿主机证书目录；compose 会只读挂载到 /run/secrets/wechatpay
WX_PAY_CERT_DIR=./secrets/wechatpay
# 宿主机证书共享组的数字 GID；私钥建议 root:<此组> 0640，严禁对 other 开放
WX_PAY_CERT_GID=10001
WX_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay/apiclient_key.pem
WX_PAY_PUBLIC_KEY_ID=
WX_PAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay/pub_key.pem
WX_PAY_NOTIFY_URL=https://api.xihongzhubao.com/api/payments/wechat/notify
WX_PAY_REFUND_NOTIFY_URL=https://api.xihongzhubao.com/api/payments/wechat/refund-notify
WX_PAY_INVOICE_NOTIFY_URL=https://api.xihongzhubao.com/api/payments/wechat/invoice-notify
WX_PAY_MOCK=false

# 用户登录态签名密钥（至少 32 个随机字符，不能与管理员密钥复用）
USER_TOKEN_SECRET=replace-with-at-least-32-random-characters-for-user-jwt
ALLOW_MOCK_USER=false

# Docker json-file 日志轮转
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
