{
  "name": "xihong-jewelry-mp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "predev": "node scripts/kill-dev-ports.mjs",
    "dev": "concurrently -n backend,miniprogram,backstage -c gray,yellow,white \"pnpm dev:backend\" \"pnpm --dir src/miniprogram dev:weapp\" \"pnpm --dir src/backstage dev\"",
    "dev:backend": "gradle -p src/backend bootRun",
    "dev:miniprogram": "pnpm --dir src/miniprogram dev:weapp",
    "dev:backstage": "pnpm --dir src/backstage dev",
    "build": "pnpm build:backend && pnpm --dir src/miniprogram build:weapp && pnpm --dir src/backstage build",
    "build:backend": "gradle -p src/backend clean build",
    "build:miniprogram": "pnpm --dir src/miniprogram build:weapp",
    "build:backstage": "pnpm --dir src/backstage build",
    "test:backend": "gradle -p src/backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@>=3.0.0 <6.0.0": "5.0.9",
      "fast-uri": "3.1.5",
      "immutable": "5.1.8",
      "nanoid@^3.0.0": "3.3.18",
      "postcss@^8.0.0": "8.5.23",
      "sharp": "0.35.0",
      "shell-quote": "1.9.0",
      "swiper": "12.1.2",
      "websocket-driver": "0.7.5",
      "ws@^8.0.0": "8.21.0"
    }
  }
}
